# 配置由 python deploy/case.py init test|demo 分别生成。
# 不使用固定口令；不得在此文件中填写真实数据环境的配置。
APP_PROFILE=demo
DEPLOYMENT_MODE=local
DATABASE_URL=<generated-for-new-case-database>
JWT_SECRET=<generated-independent-secret>
FIELD_ENCRYPTION_KEY=<generated-independent-secret>
INSTALLATION_ID=<generated-installation-id>
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
